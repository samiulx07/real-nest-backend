generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)

  passwordResetOtp       String?
  passwordResetOtpExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     Media[]
  bookings  Booking[]
  payments  Payment[]

  @@map("users")
}

// ─── Property ────────────────────────────────────────────

enum PropertyStatus {
  UPCOMING
  ONGOING
  COMPLETED
  READY_TO_MOVE
  HANDOVERED
}

model Property {
  id                String         @id @default(uuid())

  title             String
  slug              String         @unique
  description       String?

  // ─ Location ─
  address           String
  area              String
  city              String         @default("Dhaka")
  division          String?
  district          String?
  upazila           String?
  union             String?

  latitude          Float?
  longitude         Float?

  // ─ Building Specs ─
  floorLabel        String         // e.g. G+10
  totalFloors       Int
  totalUnits        Int
  unitsPerFloor     Int?

  startingPrice     Float?

  // ─ Dates ─
  handoverDate      DateTime?
  completionDate    DateTime?      // Actual or expected completion
  constructionStart DateTime?      // Construction start date

  // ─ Land & Physical ─
  landArea          String?        // e.g. 8 Katha
  facing            String?        // North, South, East, West
  roadSize          String?        // e.g. 20 Feet Road
  totalParkingSlots Int?
  totalBalconies    Int?
  buildingAge       String?        // e.g. "New Construction", "2 Years"

  // ─ Facilities ─
  parkingAvailable  Boolean        @default(false)
  liftAvailable     Boolean        @default(false)
  generatorBackup   Boolean        @default(false)
  securityAvailable Boolean        @default(false)

  // ─ Compliance ─
  developerName     String?        // Developer / Builder company name
  rajukApproval     Boolean        @default(false)
  reraRegistered    Boolean        @default(false)

  // ─ Installment Settings (Global Defaults for all flats) ─
  allowInstallment       Boolean  @default(true)
  totalInstallmentMonths Int      @default(12)
  initialBookingAmount   Float    @default(100000)

  imageUrls         String[]
  amenities         String[]

  status            PropertyStatus @default(ONGOING)

  isFeatured        Boolean        @default(false)
  isPublished       Boolean        @default(true)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  flats             Flat[]

  @@map("properties")
}

// ─── Flat ────────────────────────────────────────────────

enum FlatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  UNDER_RENOVATION
}

model Flat {
  id            String     @id @default(uuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  title         String     // e.g., "Flat 4A - Deluxe Corner Unit"
  flatNumber    String     // e.g., "4A"
  floorNumber   Int        // e.g., 4 (0 = Ground, 1 = 1st floor)

  beds          Int        @default(1)
  baths         Int        @default(1)
  kitchens      Boolean    @default(true)
  balconies     Int        @default(1)

  size          Float      // Square footage e.g., 1650.0
  price         Float      // Price in currency (BDT)

  status        FlatStatus @default(AVAILABLE)

  // ─ New detail fields ─
  completionDate DateTime?  // Flat-level handover date
  furnishing     String?    // "Unfurnished", "Semi-Furnished", "Fully Furnished"
  facing         String?    // "North", "South", "East", "West", "Corner"
  floorType      String?    // "Tiles", "Marble", "Wooden", "Vitrified"
  hasGasLine     Boolean    @default(false)
  hasWaterSupply Boolean    @default(true)

  description   String?
  imageUrls     String[]   @default([])
  amenities     String[]   @default([])

  // ─ Custom Installment Override (per-flat) ─
  useCustomInstallment   Boolean  @default(false)
  totalInstallmentMonths Int?
  initialBookingAmount   Float?

  isFeatured    Boolean    @default(false)
  isPublished   Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  bookings      Booking[]

  @@map("flats")
}

// ─── Media ───────────────────────────────────────────────

model Media {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  folder      String   @default("general") // properties, flats, profiles, general
  uploadedBy  String
  user        User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media")
}

// ─── Bookings & Payments ──────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  SSLCOMMERZ
  BANK_TRANSFER
  BKASH
  NAGAD
  CASH
}

enum PaymentStatus {
  PENDING_APPROVAL
  VALIDATED
  FAILED
  CANCELLED
  REJECTED
}

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique // e.g. BK-20260727-8912
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  flatId        String
  flat          Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)

  customerName  String
  customerEmail String
  customerPhone String

  bookingAmount Float         // Total downpayment / booking amount agreed
  paidAmount    Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING_APPROVAL)
  status        BookingStatus @default(PENDING)

  installmentsPaidCount Int  @default(1)

  notes         String?
  adminNotes    String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments      Payment[]

  @@map("bookings")
}

model Payment {
  id            String        @id @default(uuid())
  tranId        String        @unique // e.g. TXN-20260727-9812
  valId         String?       // SSLCommerz validation ID
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentMethod PaymentMethod @default(SSLCOMMERZ)
  amount        Float
  currency      String        @default("BDT")

  cardType      String?       // e.g. "BKASH-BKASH", "VISA-DBBL", "NAGAD-NAGAD"
  bankTranId    String?       // Bank transfer transaction / Ref No
  senderAccount String?       // Sender account name or mobile number
  receiptUrl    String?       // Deposit slip image / document URL

  status        PaymentStatus @default(PENDING_APPROVAL)
  adminNotes    String?
  paymentDetails Json?        // Raw gateway callback data

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}