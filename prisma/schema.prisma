generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     Media[]

  @@map("users")
}

// ─── Property ────────────────────────────────────────────

enum PropertyStatus {
  UPCOMING
  ONGOING
  COMPLETED
  READY_TO_MOVE
  HANDOVERED
}

model Property {
  id                String         @id @default(uuid())

  title             String
  slug              String         @unique
  description       String?

  // ─ Location ─
  address           String
  area              String
  city              String         @default("Dhaka")
  division          String?
  district          String?
  upazila           String?
  union             String?

  latitude          Float?
  longitude         Float?

  // ─ Building Specs ─
  floorLabel        String         // e.g. G+10
  totalFloors       Int
  totalUnits        Int
  unitsPerFloor     Int?

  startingPrice     Float?

  // ─ Dates ─
  handoverDate      DateTime?
  completionDate    DateTime?      // Actual or expected completion
  constructionStart DateTime?      // Construction start date

  // ─ Land & Physical ─
  landArea          String?        // e.g. 8 Katha
  facing            String?        // North, South, East, West
  roadSize          String?        // e.g. 20 Feet Road
  totalParkingSlots Int?
  totalBalconies    Int?
  buildingAge       String?        // e.g. "New Construction", "2 Years"

  // ─ Facilities ─
  parkingAvailable  Boolean        @default(false)
  liftAvailable     Boolean        @default(false)
  generatorBackup   Boolean        @default(false)
  securityAvailable Boolean        @default(false)

  // ─ Compliance ─
  developerName     String?        // Developer / Builder company name
  rajukApproval     Boolean        @default(false)
  reraRegistered    Boolean        @default(false)

  imageUrls         String[]
  amenities         String[]

  status            PropertyStatus @default(ONGOING)

  isFeatured        Boolean        @default(false)
  isPublished       Boolean        @default(true)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  flats             Flat[]

  @@map("properties")
}

// ─── Flat ────────────────────────────────────────────────

enum FlatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  UNDER_RENOVATION
}

model Flat {
  id            String     @id @default(uuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  title         String     // e.g., "Flat 4A - Deluxe Corner Unit"
  flatNumber    String     // e.g., "4A"
  floorNumber   Int        // e.g., 4 (0 = Ground, 1 = 1st floor)

  beds          Int        @default(1)
  baths         Int        @default(1)
  kitchens      Int        @default(1)
  balconies     Int        @default(1)

  size          Float      // Square footage e.g., 1650.0
  price         Float      // Price in currency (BDT)

  status        FlatStatus @default(AVAILABLE)

  // ─ New detail fields ─
  completionDate DateTime?  // Flat-level handover date
  furnishing     String?    // "Unfurnished", "Semi-Furnished", "Fully Furnished"
  facing         String?    // "North", "South", "East", "West", "Corner"
  floorType      String?    // "Tiles", "Marble", "Wooden", "Vitrified"
  hasGasLine     Boolean    @default(false)
  hasWaterSupply Boolean    @default(true)

  description   String?
  imageUrls     String[]   @default([])
  amenities     String[]   @default([])

  isFeatured    Boolean    @default(false)
  isPublished   Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("flats")
}

// ─── Media ───────────────────────────────────────────────

model Media {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  folder      String   @default("general") // properties, flats, profiles, general
  uploadedBy  String
  user        User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media")
}