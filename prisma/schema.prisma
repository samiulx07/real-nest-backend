generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Property {
  id                String   @id @default(uuid())

  title             String
  slug              String   @unique
  description       String?

  address           String
  area              String
  city              String   @default("Dhaka")

  latitude          Float?
  longitude         Float?

  floorLabel        String   // Example: G+10
  totalFloors       Int
  totalUnits        Int
  unitsPerFloor     Int?

  startingPrice     Float?

  handoverDate      DateTime?
  landArea          String?  // Example: 8 Katha
  facing            String?  // North, South, East, West
  roadSize          String?  // Example: 20 Feet Road

  parkingAvailable Boolean  @default(false)
  liftAvailable    Boolean  @default(false)
  generatorBackup  Boolean  @default(false)
  securityAvailable Boolean @default(false)

  imageUrls         String[]
  amenities         String[]

  status            String?  
  // Example: Ongoing, Completed, Ready to Move, Handovered

  isFeatured        Boolean  @default(false)
  isPublished       Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  flats             Flat[]

  @@map("properties")
}

enum FlatStatus {
  AVAILABLE
  BOOKED
  SOLD
}

model Flat {
  id            String     @id @default(uuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  title         String     // e.g., "Flat 4A - Deluxe Corner Unit"
  flatNumber    String     // e.g., "4A"
  floorNumber   Int        // e.g., 4 (0 = Ground, 1 = 1st floor)

  beds          Int        @default(1)
  baths         Int        @default(1)
  kitchens      Int        @default(1)
  balconies     Int        @default(1)

  size          Float      // Square footage e.g., 1650.0
  price         Float      // Price in currency (BDT)

  status        FlatStatus @default(AVAILABLE)

  description   String?
  imageUrls     String[]   @default([])
  amenities     String[]   @default([])

  isFeatured    Boolean    @default(false)
  isPublished   Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("flats")
}